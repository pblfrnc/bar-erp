{
  "name": "dev-panel",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:server": "node --experimental-strip-types server/server.ts",
    "dev:client": "vite --port 5174",
    "dev": "concurrently -n \"DEV-API,DEV-UI\" -c \"magenta,cyan\" \"npm run dev:server\" \"npm run dev:client\"",
    "build:client": "npx vite build",
    "start": "node --experimental-strip-types server/server.ts",
    "build": "npx vite build"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lucide-react": "^1.41.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
