datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

model Table {
  id            String    @id @default(cuid())
  number        Int       @unique
  name          String?
  capacity      Int       @default(4)
  status        String    @default("AVAILABLE") // AVAILABLE, OCCUPIED, CLOSING, RESERVED
  section       String    @default("Salão Principal") // Salão Principal, Deck Externo, Balcão, VIP
  currentOrderId String?
  customerCount Int       @default(1)
  customerName  String?
  openedAt      DateTime?
  mergedIntoTableId String? // Caso esteja agrupada com outra mesa
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  orders        Order[]
}

model Order {
  id                 String      @id @default(cuid())
  orderNumber        Int         @default(1)
  tableId            String?
  table              Table?      @relation(fields: [tableId], references: [id])
  status             String      @default("OPEN") // OPEN, PAID, CANCELLED
  customerName       String?
  customerId         String?
  customer           Customer?   @relation(fields: [customerId], references: [id])

  waiterId           String?
  waiter             Waiter?     @relation(fields: [waiterId], references: [id])
  waiterName         String?     @default("Garçom")
  subtotal           Float       @default(0)
  serviceFeeRate     Float       @default(0.10) // 10%
  serviceFee         Float       @default(0)
  discount           Float       @default(0)
  total              Float       @default(0)
  paidAmount         Float       @default(0)
  isServiceFeeActive Boolean     @default(false)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  closedAt           DateTime?
  items              OrderItem[]
  payments           Payment[]
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Int      @default(1)
  unitPrice  Float
  totalPrice Float
  unitType   String?  @default("UNIT") // "UNIT" ou "BOX"
  notes      String?  // Ex: "Sem gelo", "Com limão espremido"
  paidQuantity Int      @default(0)
  modifiers     String?  // JSON: [{ group, name, price }] escolhidos no pedido (preço já somado ao unitPrice)
  basePrice     Float?   // Preço unitário de tabela antes da promoção do dia
  promotionName String?  // Promoção do dia aplicada ao item

  kdsStatus  String   @default("PENDING") // PENDING, PREPARING, READY, DELIVERED
  kdsStation String   @default("BAR") // BAR, KITCHEN, NONE
  addedAt    DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Category {
  id        String    @id @default(cuid())
  name      String
  icon      String?   @default("Beer")
  sortOrder Int       @default(0)
  codeStart Int?      @default(1001) // Início da numeração sequencial (ex: 5001 para bebidas, 6001 para doces/chicletes)
  products  Product[]
}

model Product {
  code        String?     // Código interno (ex: BEB-001)
  ean         String?     // Código de Barras EAN / GTIN
  supplier    String?     // Fornecedor (texto livre para compatibilidade)
  supplierId  String?     // ID do fornecedor vinculado
  supplierRel Supplier?   @relation(fields: [supplierId], references: [id])
  ncm         String?     // Nomenclatura Comum do Mercosul
  cfop        String?     // Código Fiscal de Operações
  cest        String?     // Código Especificador da Substituição Tributária
  brand       String?     // Marca

  components  ProductComponent[] @relation("ParentProduct")
  usedIn      ProductComponent[] @relation("ComponentProduct")

  id          String      @id @default(cuid())
  name        String
  description String?
  price       Float
  costPrice   Float?
  targetMargin Float?    // Margem de lucro alvo cadastrada pelo usuário (%)

  // Venda por Caixa / Fardo Fechado
  hasBoxPrice    Boolean   @default(false)
  boxQuantity    Int?      @default(24) // Qtd de unidades por caixa (ex: 6, 12, 15, 24)
  boxPrice       Float?    // Preço total de venda da caixa fechada
  boxCostPrice   Float?    // Preço de custo da caixa fechada
  boxEan         String?   // Código de barras EAN/DUN-14 da caixa

  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id])
  kdsStation  String      @default("BAR") // BAR, KITCHEN, NONE
  stock       Int         @default(100)
  trackStock  Boolean     @default(true)
  minStock    Int         @default(10)
  unit        String      @default("un")
  isActive    Boolean     @default(true)
  showInMenu  Boolean     @default(true) // aparece no cardápio digital (QR na mesa)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  orderItems  OrderItem[]
  priceHistories PriceHistory[]
  modifierGroups ProductModifierGroup[]
}

model PriceHistory {
  id             String   @id @default(cuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  oldCostPrice   Float?
  newCostPrice   Float?
  oldPrice       Float
  newPrice       Float
  costDiff       Float?
  costPercent    Float?
  priceDiff      Float
  pricePercent   Float
  changedBy      String   @default("Operador")
  reason         String   // "IMPORT_XML" ou "MANUAL_UPDATE"
  nfeChave       String?
  createdAt      DateTime @default(now())
}

model Payment {
  id          String     @id @default(cuid())
  orderId     String
  order       Order      @relation(fields: [orderId], references: [id])
  amount      Float
  method      String     // CASH, CREDIT_CARD, DEBIT_CARD, PIX, VOUCHER
  cashShiftId String?
  cashShift   CashShift? @relation(fields: [cashShiftId], references: [id])
  notes       String?    // Ex: "Pessoa 1/2", "PIX mesa 3"
  receivedAt  DateTime   @default(now())
}

model CashShift {
  id             String            @id @default(cuid())
  openedAt       DateTime          @default(now())
  closedAt       DateTime?
  openedBy       String            @default("Operador de Caixa")
  closedBy       String?
  initialBalance Float             @default(0) // Fundo de troco
  finalBalance   Float?
  expectedBalance Float?
  difference     Float?
  status         String            @default("OPEN") // OPEN, CLOSED
  notes          String?
  payments       Payment[]
  transactions   CashTransaction[]
}

model CashTransaction {
  id          String    @id @default(cuid())
  cashShiftId String
  cashShift   CashShift @relation(fields: [cashShiftId], references: [id])
  type        String    // SUPPLY (suprimento), WITHDRAWAL (sangria)
  amount      Float
  reason      String
  createdAt   DateTime  @default(now())
}

model Waiter {
  id             String    @id @default(cuid())
  name           String    @unique
  code           String?   // Código de crachá ou identificação rápida (ex: "01", "10")
  commissionRate Float     @default(0.10) // Taxa de comissão padrão (10%)
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  orders         Order[]
}

model SystemSettings {
  id               String    @id @default("default")
  restaurantName   String    @default("Meu Bar")
  licenseEmail     String?
  licenseKey       String?
  machineId        String?
  isLicensed       Boolean   @default(false)
  defaultProfitMargin Float? @default(50.0) // Margem de lucro padrão (%) para novos produtos e cálculos de XML
  expiresAt        DateTime?
  lastVerifiedAt   DateTime?
  clientName       String?
  licenseStatus    String?   @default("UNLICENSED") // ACTIVE, EXPIRED, BLOCKED, UNLICENSED
  licenseServerUrl String?
  developerContact String?
  updatedAt        DateTime  @updatedAt
}

model ProductComponent {
  id             String   @id @default(cuid())
  parentProductId String
  parentProduct   Product  @relation("ParentProduct", fields: [parentProductId], references: [id], onDelete: Cascade)
  componentId     String
  component       Product  @relation("ComponentProduct", fields: [componentId], references: [id], onDelete: Restrict)
  quantity        Float    // Quantidade descontada (ex: 3 para 3 litrões)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([parentProductId, componentId])
}

model AuditLog {
  id          String   @id @default(cuid())
  action      String   // e.g. "CANCEL_ITEM", "APPLY_DISCOUNT"
  description String
  userId      String?
  createdAt   DateTime @default(now())
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  document  String?  // CPF/CNPJ
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  creditTabBalance Float @default(0) // Quanto o cliente está devendo (Fiado)
  orders           Order[]
}

model FiscalSettings {
  cep          String?
  logradouro   String?
  numero       String?
  bairro       String?
  municipio    String?
  uf           String?
  razaoSocial  String?
  nomeFantasia String?

  environment String? @default("homologacao")

  serieNfce         String?  @default("1")
  proximoNumeroNfce Int?     @default(1)

  serieNfe          String?  @default("1")
  proximoNumeroNfe  Int?     @default(1)

  id          String   @id @default("default")
  apiToken    String?
  cnpj        String?
  ie          String?
  crt         String?
  cscId       String?
  cscSecret   String?
  addressInfo String?
  updatedAt   DateTime @updatedAt
}

model NotaRecebida {
  id           String   @id
  chave        String   @unique
  emitente     String?
  cnpjEmitente String?
  numero       String?
  serie        String?
  dataEmissao  String?
  valorTotal   Float?
  status       String   @default("recebida")
  xmlContent   String?
  createdAt    DateTime @default(now())
}

model NotaEmitida {
  id           String   @id @default(cuid())
  referencia   String   @unique
  chave        String?
  numero       String?
  serie        String?
  dataEmissao  String?
  valorTotal   Float?
  status       String   @default("autorizado")
  xmlUrl       String?
  pdfUrl       String?
  createdAt    DateTime @default(now())
}

model Supplier {
  id          String    @id @default(cuid())
  name        String    // Razão Social ou Nome Principal
  tradeName   String?   // Nome Fantasia
  document    String?   @unique // CNPJ ou CPF
  ie          String?   // Inscrição Estadual
  phone       String?
  email       String?
  city        String?
  state       String?
  address     String?
  contactName String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Staff {
  id             String    @id @default(cuid())
  name           String
  role           String    @default("OPERADOR") // ADMIN, GERENTE, CAIXA, GARCOM, COZINHA, ESTOQUISTA
  password       String
  permissions    String    @default("[\"tables\",\"cash\"]") // JSON com ids das abas/módulos permitidos
  active         Boolean   @default(true)
  failedAttempts Int       @default(0)
  lockoutUntil   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// Adicionais e perguntas do pedido (ex: "Ponto da carne", "Adicionais do lanche", "Gelo e limão")
model ModifierGroup {
  id        String                 @id @default(cuid())
  name      String
  minSelect Int                    @default(0) // >= 1 = pergunta obrigatória
  maxSelect Int                    @default(1) // 0 = sem limite
  sortOrder Int                    @default(0)
  isActive  Boolean                @default(true)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  options   ModifierOption[]
  products  ProductModifierGroup[]
}

model ModifierOption {
  id        String        @id @default(cuid())
  groupId   String
  group     ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name      String
  price     Float         @default(0) // Acréscimo no preço do item
  sortOrder Int           @default(0)
  isActive  Boolean       @default(true)
}

model ProductModifierGroup {
  productId String
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  groupId   String
  group     ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sortOrder Int           @default(0)

  @@id([productId, groupId])
}

// Promoções do dia / Happy Hour: preço especial por dia da semana e horário
model Promotion {
  id           String   @id @default(cuid())
  name         String
  isActive     Boolean  @default(true)
  daysOfWeek   String   @default("0,1,2,3,4,5,6") // 0 = domingo ... 6 = sábado
  startTime    String   @default("00:00") // HH:MM
  endTime      String   @default("23:59") // HH:MM (menor que o início = atravessa a meia-noite)
  discountType String   @default("PERCENT") // PERCENT (% de desconto) ou FIXED_PRICE (preço fixo)
  value        Float
  productIds   String   @default("[]") // JSON com ids de produtos
  categoryIds  String   @default("[]") // JSON com ids de categorias
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Cardápio digital por QR na mesa (publicado no site do Netlify; ver menu/ e server/src/services/digitalMenu.ts)
// Foto do produto no cardápio digital (tabela separada para não pesar a listagem de produtos)
model ProductImage {
  productId     String   @id
  data          Bytes
  mimeType      String
  hash          String   // SHA-256 (32 hex) da imagem; vai na URL publicada
  publishedHash String?  // hash já enviado ao site do cardápio
  updatedAt     DateTime @updatedAt
}

model DigitalMenuSettings {
  id                String    @id @default("default")
  enabled           Boolean   @default(false)
  siteUrl           String?   // vazio = site padrão do BarERP
  storeId           String?   // identificador público da loja na URL do QR (gerado na 1ª publicação)
  publishSecret     String?   // chave de publicação da loja (nunca sai do servidor)
  title             String?   // nome exibido no cardápio (vazio = nome do bar)
  message           String?   // recado no topo (ex: horário, Wi-Fi)
  hiddenCategoryIds String    @default("[]") // JSON com categorias fora do cardápio
  hideSoldOut       Boolean   @default(false) // false = mostra "Esgotado"; true = esconde o produto
  lastPublishedAt   DateTime?
  lastHash          String?
  lastError         String?
  updatedAt         DateTime  @updatedAt
}
